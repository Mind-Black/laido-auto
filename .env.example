# Planning template: consumed by the future Vite application.
# Every VITE_ variable is public in the browser bundle.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-legacy-anon-key
VITE_BASE_PATH=/
VITE_APP_URL=http://localhost:5173/

# Never add service-role keys, database passwords, OAuth client secrets,
# notification credentials, or a Supabase access token to VITE_ variables.
# Booking policy and building timezone live in PostgreSQL, not frontend env.
